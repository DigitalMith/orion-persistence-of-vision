# ======================
# Orion/TGWUI Safe Gitignore
# ======================

# Virtual environments (never commit)
venv*/
.venv*/

# Python cache
__pycache__/
*.pyc

# === LARGE MODEL FILES (NEVER COMMIT) ===
models/
loras/
training_output/
*.gguf
*.safetensors
*.pt
*.ckpt
*.onnx

# Node modules (massive, auto-generated)
extensions/*/node_modules/

# Ignore temporary or debug files
*.log
temp_*.py
*.tmp
*.bak

# === TGWUI Embedded Installer (HUGE; never commit) ===
installer_files/

# HuggingFace caches (not needed but safe)
hf_cache/
huggingface_cache/
transformers_cache/

# TGWUI models folder — do NOT commit multi-GB models
models/*

# === Embedding models (all excluded; downloaded separately) ===
orion_cli/models/embeddings/*
!orion_cli/models/embeddings/.gitkeep


installer_files/env/