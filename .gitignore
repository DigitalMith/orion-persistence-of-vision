# ======================
# Orion/TGWUI Safe Gitignore
# ======================

# Virtual environments (never commit)
venv*/
.venv*/

# Python cache
__pycache__/
*.pyc

# === LARGE MODEL FILES (NEVER COMMIT) ===
models/
loras/
training_output/
*.gguf
*.safetensors
*.pt
*.ckpt
*.onnx

# Node modules (massive, auto-generated)
extensions/*/node_modules/

# Ignore temporary or debug files
*.log
temp_*.py
*.tmp
*.bak

# === TGWUI Embedded Installer (HUGE; never commit) ===
installer_files/

# HuggingFace caches (not needed but safe)
hf_cache/
huggingface_cache/
transformers_cache/

# TGWUI models folder — do NOT commit multi-GB models
models/*

# === Embedding models (all excluded; downloaded separately) ===
orion_cli/models/embeddings/*
!orion_cli/models/embeddings/.gitkeep

installer_files/env/
orion_cli/.env
.git_backup_before_bfg/

# === Include CLI source ===
!user_data/orion_cli/
!user_data/orion_cli/**/*.py
!user_data/orion_cli/pyproject.toml
!user_data/orion_cli/README.md

# === Exclude runtime directories ===
user_data/orion_cli/chromadb/
user_data/orion_cli/hf_cache/
user_data/orion_cli/embeddings/
user_data/orion_cli/__pycache__/

# === Exclude user-owned runtime configs ===
user_data/orion_cli/*.yaml
user_data/orion_cli/*.json
